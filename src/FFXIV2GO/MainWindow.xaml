<ui:FluentWindow x:Class="FFXIV2GO.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FFXIV2GO.Services"
                 xmlns:vm="clr-namespace:FFXIV2GO.ViewModels"
                 xmlns:views="clr-namespace:FFXIV2GO.Views"
                 Title="FFXIV2GO"
                 Width="1160" Height="760"
                 MinWidth="940" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InitViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UninstallViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppManagerViewModel}">
            <views:AppManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FFXIV2GO" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Grid Grid.Column="0">
                <StackPanel Margin="24,16,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Image Source="Assets/ffxiv2go.png" Width="34" Height="34" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Title]}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Subtitle]}"
                                   FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Icon="{Binding Symbol}"
                                       Content="{Binding Title}"
                                       Tag="{Binding Key}"
                                       Click="NavButton_Click"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Padding="16,10"
                                       Margin="0,4"
                                       FontSize="14" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" Padding="28,24,28,24">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
