<ui:FluentWindow x:Class="FFXIV2GO.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FFXIV2GO.Services"
                 xmlns:vm="clr-namespace:FFXIV2GO.ViewModels"
                 xmlns:views="clr-namespace:FFXIV2GO.Views"
                 Title="FFXIV2GO"
                 Width="1160" Height="760"
                 MinWidth="940" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InitViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UninstallViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanViewModel}">
            <views:WizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppManagerViewModel}">
            <views:AppManagerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FFXIV2GO" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Grid Grid.Column="0">
                <StackPanel Margin="24,16,16,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                    <Image Source="Assets/ffxiv2go.png" Width="34" Height="34" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Title]}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Subtitle]}"
                                   FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Icon="{Binding Symbol}"
                                       Content="{Binding Title}"
                                       Tag="{Binding Key}"
                                       Click="NavButton_Click"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Left"
                                       Padding="16,10"
                                       Margin="0,4"
                                       FontSize="14" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" Padding="28,24,28,24">
                    <ContentControl Content="{Binding CurrentPage}" />
                </Border>

                <!-- Toast 通知 -->
                <ui:InfoBar Title="{Binding ToastMessage}"
                            Severity="{Binding ToastSeverity}"
                            IsOpen="{Binding IsToastOpen}"
                            IsClosable="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,120"
                            MaxWidth="420" />

                <!-- 全局浮动按钮：Play=安装并启动，Stop=卸载 -->
                <ui:Button Width="64" Height="64" CornerRadius="20" Padding="0"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,40"
                           Appearance="Primary"
                           Command="{Binding FabCommand}"
                           ToolTip="{Binding FabTooltip}">
                    <ui:SymbolIcon Width="28" Height="28" FontSize="28" Filled="True"
                                   Foreground="White">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Play24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FabIsPlay}" Value="False">
                                        <Setter Property="Symbol" Value="Stop24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
