<Application x:Class="FFXIV2GO.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:FFXIV2GO.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <views:StepGlyphConverter x:Key="StepGlyph" />
            <views:StepColorConverter x:Key="StepColor" />
            <views:StepProgressVisibilityConverter x:Key="StepProgressVisible" />
            <views:BoolToVisibilityConverter x:Key="BoolToVisible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
