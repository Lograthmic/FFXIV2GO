<UserControl x:Class="FFXIV2GO.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FFXIV2GO.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap" />

            <ui:Card Margin="0,20,0,0" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Games24" Filled="True" Width="48" Height="48" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Title]}"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Subtitle]}"
                                       FontSize="12" Opacity="0.6" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.Version]}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <TextBlock Text="{Binding VersionText}" Opacity="0.7" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.Repository]}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,20,0,0" />
                    <TextBlock Text="Lograthmic/FFXIV2GO" Opacity="0.7" Margin="0,6,0,0" />

                    <ui:Button Appearance="Primary"
                               Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.OpenGitHub]}"
                               Command="{Binding OpenGitHubCommand}"
                               HorizontalAlignment="Left"
                               Margin="0,14,0,0" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.Environment]}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.DeploymentRoot]}" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeploymentRootDisplay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[About.ConfigFile]}" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ConfigFileDisplay}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
