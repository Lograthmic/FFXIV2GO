<UserControl x:Class="FFXIV2GO.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                             xmlns:loc="clr-namespace:FFXIV2GO.Services"
                             xmlns:views="clr-namespace:FFXIV2GO.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dashboard.Welcome]}"
                       FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dashboard.WelcomeDesc]}"
                       FontSize="14" Opacity="0.7" Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Margin="8"
                                       Padding="24,28"
                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="{Binding Symbol}" Filled="True" Width="64" Height="64" FontSize="64" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                    <views:StatusIndicator Status="{Binding Status}" Margin="8,1,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Desc}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card Margin="8,24,8,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dashboard.EnvInfo]}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dashboard.EnvPath]}" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeploymentRootDisplay}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Dashboard.EnvConfig]}" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ConfigFileDisplay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[App.Version]}" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding VersionText}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
