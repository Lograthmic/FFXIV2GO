<ui:FluentWindow x:Class="FFXIV2GO.Views.AppSelectWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FFXIV2GO.Services"
                 Title="FFXIV2GO"
                 Width="460"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round">
    <StackPanel Margin="28,24,28,24" MinWidth="400">
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppSelect.Title]}"
                   FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppSelect.Hint]}"
                   FontSize="12" Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap" />

        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="{Binding Name}"
                                  FontSize="14"
                                  Margin="0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="RequiredHint"
                   FontSize="12"
                   Opacity="0.85"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[Common.Cancel]}"
                       Click="Cancel_Click" />
            <ui:Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppSelect.Download]}"
                       Appearance="Primary"
                       Margin="12,0,0,0"
                       Click="Download_Click" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
